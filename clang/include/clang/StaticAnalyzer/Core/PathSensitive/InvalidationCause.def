#ifndef INVALIDATION_CAUSE
#define INVALIDATION_CAUSE(Id, Parent)
#endif

#ifndef ABSTRACT_INVALIDATION_CAUSE
#define ABSTRACT_INVALIDATION_CAUSE(Id, Parent)
#endif

#ifndef INVALIDATION_CAUSE_RANGE
#define INVALIDATION_CAUSE_RANGE(Id, First, Last)
#endif

ABSTRACT_INVALIDATION_CAUSE(UnmodeledCall, InvalidationCause)
  INVALIDATION_CAUSE(ConservativeEvalCall, UnmodeledCall)
  INVALIDATION_CAUSE(PartiallyModeledCall, UnmodeledCall)
INVALIDATION_CAUSE_RANGE(UNMODELEDCALLS, ConservativeEvalCallKind, PartiallyModeledCallKind)

ABSTRACT_INVALIDATION_CAUSE(UnmodeledStmt, InvalidationCause)
  INVALIDATION_CAUSE(UnmodeledExpr, UnmodeledStmt)
  INVALIDATION_CAUSE(LoopWidening, UnmodeledStmt)
INVALIDATION_CAUSE_RANGE(UNMODELEDSTMTS, UnmodeledExprKind, LoopWideningKind)

#undef INVALIDATION_CAUSE
#undef ABSTRACT_INVALIDATION_CAUSE
#undef INVALIDATION_CAUSE_RANGE
